{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waggle.local/schemas/longmemeval-result-row.schema.json",
  "title": "Waggle LongMemEval result row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "case_id",
    "suite",
    "split",
    "category",
    "condition",
    "reader_model",
    "judge_model",
    "dataset_sha256",
    "prompt_version",
    "run_artifact",
    "gold_support_ids",
    "retrieved_support_ids",
    "context_tokens",
    "input_tokens",
    "output_tokens",
    "answer",
    "judge_result",
    "latency_seconds",
    "cost_usd",
    "official_table_eligible"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "suite": {
      "type": "string",
      "enum": ["longmemeval_s", "supplementary_stress"]
    },
    "split": {
      "type": "string",
      "enum": ["mock", "tune", "heldout", "full", "stratified_150", "stress"]
    },
    "category": { "type": "string", "minLength": 1 },
    "condition": {
      "type": "string",
      "enum": [
        "full_context",
        "flat_vector",
        "waggle_full",
        "ablation_semantic_only",
        "ablation_lexical_only",
        "ablation_temporal_only",
        "ablation_no_graph_expansion",
        "ablation_no_conflict_update"
      ]
    },
    "reader_model": { "type": "string", "minLength": 1 },
    "judge_model": { "type": "string", "minLength": 1 },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "prompt_version": { "type": "string", "minLength": 1 },
    "run_artifact": { "type": "string", "minLength": 1 },
    "gold_support_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "retrieved_support_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "context_tokens": { "type": "integer", "minimum": 0 },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "answer": { "type": "string" },
    "judge_result": {
      "type": "object",
      "required": ["score"],
      "properties": {
        "score": {
          "type": ["number", "boolean"]
        },
        "rationale": { "type": "string" }
      },
      "additionalProperties": true
    },
    "latency_seconds": { "type": "number", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "official_table_eligible": { "type": "boolean" }
  }
}
